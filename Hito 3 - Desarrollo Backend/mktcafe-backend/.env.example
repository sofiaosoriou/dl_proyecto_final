# ============================================================
#  MktCafé Backend — Variables de entorno
#  Copia este archivo como .env y rellena los valores
# ============================================================

# ── Base de datos ──────────────────────────────────────────
# Opción A (producción): connection string de Neon / Render / Supabase
DATABASE_URL=postgresql://usuario:contraseña@host/nombre_db?sslmode=require

# Opción B (desarrollo local): variables individuales
# (Solo se usan si DATABASE_URL NO está definida)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mktcafe
DB_USER=postgres
DB_PASSWORD=

# ── JWT ────────────────────────────────────────────────────
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_seguro

# ── Servidor ───────────────────────────────────────────────
PORT=3000

# ── CORS ───────────────────────────────────────────────────
# URL de producción del frontend (Netlify, Vercel, etc.)
FRONTEND_URL=https://tu-app.netlify.app
